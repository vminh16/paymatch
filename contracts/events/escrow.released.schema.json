{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/escrow.released.schema.json",
  "title": "EscrowReleasedEvent",
  "description": "Khoản cọc tạm giữ đã được giải ngân cho nhà cung cấp khi đủ phiếu nhập và hóa đơn duyệt kênh escrow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "escrow.released"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "EscrowReleasedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "escrow_id",
        "release_invoice_id",
        "source_invoice_id"
      ],
      "properties": {
        "escrow_id": {
          "type": "string",
          "pattern": "^esc_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "release_invoice_id": {
          "type": "string",
          "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "source_invoice_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810WW9BCDEFGHJKMNPQRST",
      "type": "escrow.released",
      "schema_version": 1,
      "occurred_at": "2026-11-28T14:20:00+07:00",
      "tenant_id": "ten_01M88D3C06B97Y4G0S9W8BVKNG",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "escrow_id": "esc_01M88A6SAP3R27VDQ55VAKCF0P",
        "release_invoice_id": "inv_01M883YAYXMNBVDV7CSN4MH4C4",
        "source_invoice_id": "inv_01M883YAYXMNBVDV7CSN4MH4C4"
      }
    }
  ]
}
