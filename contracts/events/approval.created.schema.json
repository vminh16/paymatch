{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/approval.created.schema.json",
  "title": "ApprovalCreatedEvent",
  "description": "Bản ghi Approval mới được tạo (single, bulk hoặc mandate).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "approval.created"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "ApprovalCreatedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "invoice_id",
        "purchase_order_id",
        "method"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^apv_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "invoice_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "purchase_order_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^po_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "method": {
          "$ref": "../schemas/approval-method.schema.json"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810CC3BCDEFGHJKMNPQRST",
      "type": "approval.created",
      "schema_version": 1,
      "occurred_at": "2026-11-26T08:31:15+07:00",
      "tenant_id": "ten_01M88D3C06B97Y4G0S9W8BVKNG",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "approval_id": "apv_01M883BRJ9DP97B91S0CMK8PZJ",
        "invoice_id": "inv_01M882P8NTCDKGE2KVFMBTS5RK",
        "purchase_order_id": null,
        "method": "single"
      }
    }
  ]
}
