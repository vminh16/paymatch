{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/bot.status_changed.schema.json",
  "title": "BotStatusChangedEvent",
  "description": "Trạng thái phiên bản bot thay đổi trong vòng đời quản trị bot (F5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "bot.status_changed"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "BotStatusChangedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot_id",
        "version",
        "from",
        "to"
      ],
      "properties": {
        "bot_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "anyOf": [
            {
              "$ref": "../schemas/bot-status.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "$ref": "../schemas/bot-status.schema.json"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810ZZ2BCDEFGHJKMNPQRST",
      "type": "bot.status_changed",
      "schema_version": 1,
      "occurred_at": "2026-11-26T10:30:00+07:00",
      "tenant_id": "ten_01M88D3C06B97Y4G0S9W8BVKNG",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "bot_id": "bot_01M885AXP309SER6BAC46N5FJT",
        "version": 1,
        "from": "pending_review",
        "to": "active"
      }
    }
  ]
}
