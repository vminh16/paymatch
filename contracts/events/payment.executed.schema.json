{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/payment.executed.schema.json",
  "title": "PaymentExecutedEvent",
  "description": "Payment Gate đã thực thi lệnh chi thành công trên rail (settled).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "payment.executed"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "PaymentExecutedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_intent_id",
        "invoice_id",
        "rail_txn_id",
        "settled_at"
      ],
      "properties": {
        "payment_intent_id": {
          "type": "string",
          "pattern": "^pi_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "invoice_id": {
          "type": "string",
          "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "rail_txn_id": {
          "type": "string",
          "minLength": 1
        },
        "settled_at": {
          "$ref": "../schemas/timestamp.schema.json"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8829CEDBM4FF9Z257TVZ0EH",
      "type": "payment.executed",
      "schema_version": 1,
      "occurred_at": "2026-11-26T08:06:12+07:00",
      "tenant_id": "ten_01M88D3C06B97Y4G0S9W8BVKNG",
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "payment_intent_id": "pi_01M88557BXGABQA8KPG2382VH5",
        "invoice_id": "inv_01M8808XXD8017SJ9NTGTNC48Y",
        "rail_txn_id": "rtx_01M88H11Y0WR367CGNZZH603T5",
        "settled_at": "2026-11-26T08:06:12+07:00"
      }
    }
  ]
}
