{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/cross_alert.published.schema.json",
  "title": "CrossAlertPublishedEvent",
  "description": "Cảnh báo chéo toàn mạng được chuyên viên rủi ro MoMo phát hành (F3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "cross_alert.published"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "CrossAlertPublishedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_alert_id",
        "indicators",
        "reason_codes"
      ],
      "properties": {
        "cross_alert_id": {
          "type": "string",
          "pattern": "^cxa_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../schemas/indicator-ref.schema.json"
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../schemas/reason-code.schema.json"
          }
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810HH8BCDEFGHJKMNPQRST",
      "type": "cross_alert.published",
      "schema_version": 1,
      "occurred_at": "2026-11-26T08:55:30+07:00",
      "tenant_id": null,
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "cross_alert_id": "cxa_01M885AXP309SER6BAC46N5FJT",
        "indicators": [
          {
            "kind": "account_hash",
            "value_hash": "c7dfe487bab58ead104ced293dedb9d0c93415fb6d57829084a2f0caba57212a"
          }
        ],
        "reason_codes": [
          "PERSONAL_ACCOUNT",
          "HIDDEN_INSTRUCTION"
        ]
      }
    }
  ]
}
