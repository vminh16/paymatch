{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/cross_alert.withdrawn.schema.json",
  "title": "CrossAlertWithdrawnEvent",
  "description": "Cảnh báo chéo được gỡ sau phê duyệt maker-checker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "cross_alert.withdrawn"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "CrossAlertWithdrawnData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_alert_id"
      ],
      "properties": {
        "cross_alert_id": {
          "type": "string",
          "pattern": "^cxa_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810JJ9BCDEFGHJKMNPQRST",
      "type": "cross_alert.withdrawn",
      "schema_version": 1,
      "occurred_at": "2026-11-26T10:15:00+07:00",
      "tenant_id": null,
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "cross_alert_id": "cxa_01M885AXP309SER6BAC46N5FJT"
      }
    }
  ]
}
