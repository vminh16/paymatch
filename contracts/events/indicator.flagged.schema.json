{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/events/indicator.flagged.schema.json",
  "title": "IndicatorFlaggedEvent",
  "description": "Chỉ báo rủi ro được gắn cờ từ Finding gian lận hoặc sự kiện thẻ ảo bị từ chối trên rail (F3, F8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "trace_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "indicator.flagged"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../schemas/timestamp.schema.json"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "title": "IndicatorFlaggedData",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicators",
        "reason_codes",
        "source",
        "source_ref"
      ],
      "properties": {
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "FlaggedIndicatorItem",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value_hash"
            ],
            "properties": {
              "kind": {
                "$ref": "../schemas/indicator-kind.schema.json"
              },
              "value_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "../schemas/reason-code.schema.json"
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "finding",
            "rail"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Mã tham chiếu mờ (opaque), không lộ id hóa đơn hoặc Finding của tenant."
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "evt_01M8810GG7BCDEFGHJKMNPQRST",
      "type": "indicator.flagged",
      "schema_version": 1,
      "occurred_at": "2026-11-26T08:35:40+07:00",
      "tenant_id": null,
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "data": {
        "indicators": [
          {
            "kind": "account_hash",
            "value_hash": "c7dfe487bab58ead104ced293dedb9d0c93415fb6d57829084a2f0caba57212a"
          },
          {
            "kind": "tax_id",
            "value_hash": "0999090001"
          }
        ],
        "reason_codes": [
          "PERSONAL_ACCOUNT",
          "HIDDEN_INSTRUCTION"
        ],
        "source": "finding",
        "source_ref": "srf_9a8b7c6d5e4f3a2b"
      }
    }
  ]
}
