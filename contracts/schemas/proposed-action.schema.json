{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/schemas/proposed-action.schema.json",
  "title": "ProposedAction",
  "description": "Đề xuất hành động có cấu trúc trong câu trả lời trợ lý; UI hiển thị thành nút và vẫn đi qua xác thực chuẩn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "target_ids",
    "label"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "open_invoice",
        "open_approval_queue",
        "preview_bulk_approval",
        "open_vendor",
        "open_account_change",
        "reinvestigate_invoice"
      ]
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "label": {
      "type": "string",
      "minLength": 1
    }
  }
}
