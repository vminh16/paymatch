{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/schemas/mandate.schema.json",
  "title": "Mandate",
  "description": "Ủy nhiệm chi có version do Chủ chuỗi ký xác thực mạnh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_id",
    "version",
    "mode",
    "limits",
    "auto_pay_vendor_ids",
    "channel_rules",
    "bulk_approvable",
    "auto_pay_window",
    "signed",
    "created_at"
  ],
  "properties": {
    "mandate_id": {
      "type": "string",
      "pattern": "^man_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "$ref": "./mandate-mode.schema.json"
    },
    "limits": {
      "title": "MandateLimits",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_invoice_vnd",
        "per_day_vnd"
      ],
      "properties": {
        "per_invoice_vnd": {
          "$ref": "./money-vnd.schema.json"
        },
        "per_day_vnd": {
          "$ref": "./money-vnd.schema.json"
        }
      }
    },
    "auto_pay_vendor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ven_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "channel_rules": {
      "type": "array",
      "items": {
        "title": "MandateChannelRule",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_type",
          "channel"
        ],
        "properties": {
          "invoice_type": {
            "$ref": "./invoice-type.schema.json"
          },
          "channel": {
            "$ref": "./channel.schema.json"
          }
        }
      }
    },
    "bulk_approvable": {
      "type": "array",
      "items": {
        "title": "BulkApprovableRule",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason_codes",
          "max_amount_vnd"
        ],
        "properties": {
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "./reason-code.schema.json"
            }
          },
          "max_amount_vnd": {
            "$ref": "./money-vnd.schema.json"
          }
        }
      }
    },
    "auto_pay_window": {
      "title": "AutoPayWindow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "signed": {
      "title": "MandateSignature",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_user_id",
        "method",
        "auth_proof_jti",
        "at"
      ],
      "properties": {
        "by_user_id": {
          "type": "string",
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "auth_proof_jti": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "./timestamp.schema.json"
        }
      }
    },
    "created_at": {
      "$ref": "./timestamp.schema.json"
    }
  }
}
