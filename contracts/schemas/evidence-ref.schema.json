{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/schemas/evidence-ref.schema.json",
  "title": "EvidenceRef",
  "description": "Tham chiếu bằng chứng đã được core xác thực gắn với tool_call_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "ref_id",
    "tool_call_id"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "invoice_line",
        "invoice_document",
        "message",
        "contract_item",
        "purchase_order",
        "goods_receipt",
        "tool_call",
        "vendor_account",
        "utility_reading"
      ]
    },
    "ref_id": {
      "type": "string",
      "pattern": "^(lin|doc|msg|itm|po|grn|tcl|vac|urd)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tool_call_id": {
      "type": "string",
      "pattern": "^tcl_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
