{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/schemas/bot-manifest.schema.json",
  "title": "BotManifest",
  "description": "Khai báo manifest của một bot chuyên môn (system hoặc tenant).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "skills",
    "tools",
    "triggers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./task-type.schema.json"
      }
    },
    "triggers": {
      "title": "BotManifestTriggers",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_types"
      ],
      "properties": {
        "invoice_types": {
          "type": "array",
          "items": {
            "$ref": "./invoice-type.schema.json"
          }
        }
      }
    },
    "required_for": {
      "type": "array",
      "items": {
        "$ref": "./invoice-type.schema.json"
      }
    }
  }
}
