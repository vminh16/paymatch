{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymatch.dev/schemas/goods-receipt.schema.json",
  "title": "GoodsReceipt",
  "description": "Phiếu xác nhận nhập hàng (GRN) tại quán hoặc bếp trung tâm.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goods_receipt_id",
    "purchase_order_id",
    "store_id",
    "lines",
    "confirmed_by",
    "confirmed_at"
  ],
  "properties": {
    "goods_receipt_id": {
      "type": "string",
      "pattern": "^grn_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "purchase_order_id": {
      "type": "string",
      "pattern": "^po_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "store_id": {
      "type": "string",
      "pattern": "^sto_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "GoodsReceiptLine",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "quantity_received"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity_received": {
            "$ref": "./decimal.schema.json"
          }
        }
      }
    },
    "confirmed_by": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "confirmed_at": {
      "$ref": "./timestamp.schema.json"
    }
  }
}
