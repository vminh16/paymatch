# PayMatch: sao chép thành .env rồi điền. .env đã nằm trong .gitignore, KHÔNG commit khóa thật.
# Giá trị dev-* chỉ dùng cho local/demo.

# ── Khóa dịch vụ (X-Service-Key) ─────────────────────────────────────────────
SIM_CORE_SERVICE_KEY=dev-core-key
SIM_GATE_SERVICE_KEY=dev-gate-key
SIM_WEBHOOK_SERVICE_KEY=dev-sim-webhook-key
AGENT_SERVICE_KEY=dev-agent-key

# ── Địa chỉ (docs/05-api/README.md §1) ───────────────────────────────────────
CORE_INTERNAL_URL=http://internal-api:8003/internal

# ── agent-worker: LLM (docs/03-agents/agent-runtime.md §7) ───────────────────
# replay | record | live. Hiện chỉ có replay; live/record chờ chốt provider.
LLM_MODE=replay
LLM_CASSETTE_PATH=services/agent-runtime/tests/cassettes/brd14/BRD_01_COFFEE_26M5.json
# Provider chưa chốt. Tên model KHÔNG để ở đây: lấy từ ModelConfig (GET /internal/model-configs).
LLM_PROVIDER=
DEFAULT_BRIEF_MODEL=

# Khóa API mặc định: dùng khi bot không có khóa riêng, và cho mọi bot người dùng tạo.
LLM_API_KEY=

# Khóa riêng từng bot (tùy chọn): LLM_API_KEY_<BOT_ID viết hoa, '-' -> '_'>. Để trống = dùng LLM_API_KEY.
LLM_API_KEY_CHIEF_ACCOUNTANT=
LLM_API_KEY_PROCUREMENT=
LLM_API_KEY_ACCOUNTS_PAYABLE=
LLM_API_KEY_FRAUD_CONTROL=
LLM_API_KEY_TAX=
LLM_API_KEY_BRANCH_OPERATIONS=
LLM_API_KEY_TREASURY=

# Ngân sách và nhịp (mặc định theo spec; chỉ đổi khi thử nghiệm)
# BOT_MAX_STEPS=6
# BOT_TIMEOUT_S=20
# HEARTBEAT_INTERVAL_S=30
# TOOL_INVOKE_TIMEOUT_S=5
# TOOL_INVOKE_MAX_RETRIES_5XX=1
# POLL_INTERVAL_S=1.0
# WORKER_ID=agent-worker-local
